# 本地 PostgreSQL 连接串。
# 请复制为 .env，并按本机 PostgreSQL 用户名、密码和端口修改。
DATABASE_URL="postgresql://postgres:root@127.0.0.1:5432/postgres"

# 仅执行 MySQL 到 PostgreSQL 迁移时临时设置，不作为应用默认数据源。
# MYSQL_SOURCE_URL="mysql://root:root@127.0.0.1:3306/foreign_trade"

# 后台登录使用的初始管理员账号。
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# 可选：配置后会发送管理员新询盘通知和客户确认邮件。
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PE SOHO <no-reply@example.com>"
SESSION_SECRET="change-this-session-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
COOKIE_SECURE="false"
